        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Updated\",\n  \"lastname\": \"Boundary\",\n  \"totalprice\": 1,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2027-02-28\",\n    \"checkout\": \"2027-03-01\"\n  },\n  \"additionalneeds\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('JSON response',()=>pm.response.to.be.json);",
              "const b=pm.response.json();",
              "pm.test('updated values match request',()=>{pm.expect(b.firstname).to.eql('Updated');pm.expect(b.totalprice).to.eql(1);pm.expect(b.depositpaid).to.eql(false);pm.expect(b.bookingdates.checkin).to.eql('2027-02-28');pm.expect(b.bookingdates.checkout).to.eql('2027-03-01');});"
            ]
          }
        }
